# guidely/.gitignore

# Ignore the virtual environment (we will put it inside backend)
backend/.venv/
backend/venv/

# Ignore global environment variables
.env
.env.local

# Ignore Python cache files
**/__pycache__/
**/*.py[cod]

# Ignore generated index/cache artifacts
backend/data/faiss_index*
backend/data/embedding_cache.json
backend/data/embedding_cache.json.tmp